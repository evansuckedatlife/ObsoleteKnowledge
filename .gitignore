# Obsidian per-machine workspace state (changes every session, not worth tracking)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/

# Transient build scratch — source scope extraction, never committed
_scratch/
_sources/
.agents/
ORIGINAL_REQUEST.md



# Generated audio build artefacts (mp3/wav/plans); narration cache IS tracked
tools/audio/work/
tools/audio/state.json
audit.log
__pycache__/
*.pyc

# Colon-mangled path spills: an unquoted Windows path used as a literal
# filename. Has recurred several times from agents writing to a scratchpad.
C[[:punct:]]UsersevanP*
